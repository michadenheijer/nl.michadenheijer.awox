  ],
  "name": {
    "en": "AwoX SmartLIGHT BLE",
    "nl": "AwoX SmartLIGHT BLE"
  },
  "description": {
    "en": "Control first-generation AwoX SmartLIGHT Bluetooth bulbs (beta)",
    "nl": "Bedien eerste generatie AwoX SmartLIGHT Bluetooth-lampen (bèta)"
  },
  "category": [
    "lights"
  ],
  "permissions": [
    "homey:wireless:ble"
  ],
  "brandColor": "#1f6fb2",
  "author": {
    "name": "Micha den Heijer",
    "email": "micha@michadenheijer.com"
