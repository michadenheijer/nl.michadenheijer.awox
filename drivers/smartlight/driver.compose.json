{
  "name": {
    "en": "AwoX SmartLIGHT (white)",
    "nl": "AwoX SmartLIGHT (wit)"
  },
  "class": "light",
  "capabilities": [
    "onoff",
    "dim",
    "light_temperature"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "ble"
  ],
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Connection",
        "nl": "Verbinding"
      },
      "children": [
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Status refresh interval",
            "nl": "Status refresh interval"
          },
          "hint": {
            "en": "How often Homey reads the bulb's state, in seconds. Changes made elsewhere are usually picked up instantly; this is a safety net. 0 disables polling.",
            "nl": "Hoe vaak Homey de status van de lamp uitleest, in seconden. Wijzigingen van elders komen meestal direct binnen; dit is een vangnet. 0 schakelt verversen uit."
          },
          "value": 60,
          "min": 0,
          "max": 3600,
          "step": 10,
          "units": {
            "en": "s",
            "nl": "s"
          }
        }
      ]
    }
  ]
}
